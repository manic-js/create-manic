{
  "name": "create-manic",
  "version": "1.0.3",
  "description": "Create a new Manic app",
  "keywords": [
    "bun",
    "create",
    "manic",
    "react",
    "scaffold"
  ],
  "homepage": "https://github.com/manic-js/create-manic#readme",
  "bugs": {
    "url": "https://github.com/manic-js/create-manic/issues"
  },
  "license": "GPL-3.0",
  "author": "Rahuletto",
  "repository": {
    "type": "git",
    "url": "https://github.com/manic-js/create-manic"
  },
  "bin": {
    "create-manic": "./index.ts"
  },
  "files": [
    "index.ts",
    "template/**/*"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@manicjs/tui": "1.0.1"
  },
  "devDependencies": {
    "simple-git-hooks": "^2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "bunx --bun oxlint . && bunx --bun oxfmt --check --config .oxfmt.json ."
  }
}
